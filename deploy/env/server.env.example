SHIPWISE_ENVIRONMENT=Production
SHIPWISE_SECRETS_DIR=/etc/shipwise/secrets/shipwise-server
SHIPWISE_GATEWAY_IMAGE=ghcr.io/REPLACE_WITH_OWNER/shipwise-gateway:REPLACE_WITH_COMMIT_SHA
SHIPWISE_IDENTITY_API_IMAGE=ghcr.io/REPLACE_WITH_OWNER/shipwise-identity-api:REPLACE_WITH_COMMIT_SHA
SHIPWISE_IDENTITY_MIGRATION_IMAGE=ghcr.io/REPLACE_WITH_OWNER/shipwise-identity-migration:REPLACE_WITH_COMMIT_SHA
